+def _make_observable_probe(
+    direction: np.ndarray,
+    jacobian: ImageJacobianCalibration,
+    *,
+    target_response_px: float,
+    max_step_mm: float,
+) -> np.ndarray:
+    vector = np.asarray(direction, dtype=np.float64)
+    if vector.shape != (2,) or not np.isfinite(vector).all():
+        raise ValueError("readiness direction must be a finite 2-vector")
+    norm = float(np.linalg.norm(vector))
+    if norm <= 1e-12:
+        raise RuntimeError("readiness direction is zero")
+    unit = vector / norm
+    px_per_mm = float(np.linalg.norm(jacobian.array @ unit))
+    if px_per_mm <= 1e-12:
+        raise RuntimeError("canonical J predicts zero response along readiness direction")
+    step_mm = min(float(max_step_mm), float(target_response_px) / px_per_mm)
+    return unit * step_mm
+
+
+def _assess_conditioning_cycles(
+    previous_before: list[list[float]],
+    previous_duv: list[list[float]],
+    current_before: list[list[float]],
+    current_duv: list[list[float]],
+    *,
+    args: argparse.Namespace,
+) -> dict:
+    prev_before = np.asarray(previous_before, dtype=np.float64)
+    prev_duv = np.asarray(previous_duv, dtype=np.float64)
+    cur_before = np.asarray(current_before, dtype=np.float64)
+    cur_duv = np.asarray(current_duv, dtype=np.float64)
+    for array, name in (
+        (prev_before, "previous_before"),
+        (prev_duv, "previous_duv"),
+        (cur_before, "current_before"),
+        (cur_duv, "current_duv"),
+    ):
+        if array.shape != (4, 2) or not np.isfinite(array).all():
+            raise RuntimeError(f"conditioning {name} must be finite 4x2")
+
+    max_before_drift = float(np.max(np.linalg.norm(cur_before - prev_before, axis=1)))
+    max_response_drift = float(np.max(np.linalg.norm(cur_duv - prev_duv, axis=1)))
+    direction = _h32_direction_consistency(
+        [[args.conditioning_step_mm, 0.0], [-args.conditioning_step_mm, 0.0],
+         [0.0, args.conditioning_step_mm], [0.0, -args.conditioning_step_mm]],
+        current_duv,
+    )
+    x_cos = direction["x"]["opposition_cosine"]
+    y_cos = direction["y"]["opposition_cosine"]
+    direction_ok = (
+        x_cos is not None
+        and y_cos is not None
+        and float(x_cos) <= args.conditioning_max_opposition_cosine
+        and float(y_cos) <= args.conditioning_max_opposition_cosine
+    )
+    accepted = (
+        max_before_drift <= args.conditioning_max_before_drift_px
+        and max_response_drift <= args.conditioning_max_response_drift_px
+        and direction_ok
+    )
+    return {
+        "accepted": bool(accepted),
+        "max_before_drift_px": max_before_drift,
+        "max_response_drift_px": max_response_drift,
+        "x_opposition_cosine": x_cos,
+        "y_opposition_cosine": y_cos,
+    }
+
+
+def _run_handoff_conditioning(
+    *,
+    robot: SO101Follower,
+    camera: ThreadedOpenCVCamera,
+    recognizer: RuntimeHOGGlyphRecognizer,
+    target: str,
+    jacobian: ImageJacobianCalibration,
+    validation_kinematics,
+    motor_names: list[str],
+    args: argparse.Namespace,
+    burst_config: TargetBurstConfig,
+    artifact_dir: Path,
+    session: dict,
+    session_path: Path,
+    last_frame_id: int | None,
+    min_capture_timestamp: float | None,
+) -> tuple[int, float | None, float]:
+    """Warm the handoff mechanics with bounded fixed-anchor XY cycles.
+
+    Every conditioning sample is anchor -> probe -> anchor.  The observed data
+    are used only to decide whether the handoff has stabilized; canonical J is
+    never fitted or modified here.
+    """
+    pipeline, anchor_xyz_mm = _latch_xy_segment(
+        robot,
+        args,
+        motor_names=motor_names,
+        validation_kinematics=validation_kinematics,
+        segment_index=0,
+    )
+    motions = (
+        np.asarray((args.conditioning_step_mm, 0.0), dtype=np.float64),
+        np.asarray((-args.conditioning_step_mm, 0.0), dtype=np.float64),
+        np.asarray((0.0, args.conditioning_step_mm), dtype=np.float64),
+        np.asarray((0.0, -args.conditioning_step_mm), dtype=np.float64),
+    )
+    previous_before: list[list[float]] | None = None
+    previous_duv: list[list[float]] | None = None
+    conditioning_path_mm = 0.0
+
+    print("\n===== HANDOFF XY CONDITIONING =====", flush=True)
+    print(
+        "Readiness-only +X/-X/+Y/-Y cycles; every probe returns to the fixed anchor; "
+        "canonical J_cmd is read-only.",
+        flush=True,
+    )
+
+    for cycle in range(1, args.conditioning_max_cycles + 1):
+        cycle_before: list[list[float]] = []
+        cycle_duv: list[list[float]] = []
+        cycle_records: list[dict] = []
+
+        for phase, motion in enumerate(motions, start=1):
+            before, before_records, _, last_frame_id = _capture_target_center(
+                camera,
+                recognizer,
+                target,
+                max_frame_age_ms=args.max_frame_age_ms,
+                timeout_s=args.capture_timeout_s,
+                after_frame_id=last_frame_id,
+                min_capture_timestamp=min_capture_timestamp,
+                burst_config=burst_config,
+                fov_margin_px=args.fov_margin_px,
+                artifact_dir=artifact_dir,
+                capture_tag=f"COND_C{cycle}_P{phase}_BEFORE",
+            )
+            min_capture_timestamp = None
+
+            projected = conditioning_path_mm + 2.0 * float(np.linalg.norm(motion))
+            if projected > args.max_conditioning_path_mm + 1e-9:
+                raise RuntimeError("handoff conditioning XY path safety budget exhausted")
+
+            settled_timestamp, diagnostics_out = _command_fixed_anchor_xy(
+                robot,
+                pipeline,
+                motion,
+                motor_names=motor_names,
+                validation_kinematics=validation_kinematics,
+                anchor_xyz_mm=anchor_xyz_mm,
+                args=args,
+            )
+            after_guard = settled_timestamp + args.post_settle_guard_ms / 1000.0
+            try:
+                after, after_records, image, last_frame_id = _capture_target_center(
+                    camera,
+                    recognizer,
+                    target,
+                    max_frame_age_ms=args.max_frame_age_ms,
+                    timeout_s=args.capture_timeout_s,
+                    after_frame_id=last_frame_id,
+                    min_capture_timestamp=after_guard,
+                    burst_config=burst_config,
+                    fov_margin_px=args.fov_margin_px,
+                    artifact_dir=artifact_dir,
+                    capture_tag=f"COND_C{cycle}_P{phase}_AFTER",
+                )
+            finally:
+                # Even target-loss during the probe must attempt the bounded anchor return.
+                return_timestamp, diagnostics_return = _command_fixed_anchor_xy(
+                    robot,
+                    pipeline,
+                    np.zeros(2, dtype=np.float64),
+                    motor_names=motor_names,
+                    validation_kinematics=validation_kinematics,
+                    anchor_xyz_mm=anchor_xyz_mm,
+                    args=args,
+                )
+                conditioning_path_mm = projected
+                min_capture_timestamp = (
+                    return_timestamp + args.post_settle_guard_ms / 1000.0
+                )
+
+            actual_duv = after - before
+            predicted_duv = jacobian.array @ motion
+            print(
+                f"[COND {cycle:02d}.{phase}] dXY=({motion[0]:+.1f},{motion[1]:+.1f})mm "
+                f"predicted=({predicted_duv[0]:+.2f},{predicted_duv[1]:+.2f})px "
+                f"actual=({actual_duv[0]:+.2f},{actual_duv[1]:+.2f})px",
+                flush=True,
+            )
+            _preview(
+                artifact_dir / f"conditioning_c{cycle:02d}_p{phase:02d}.jpg",
+                image,
+                after,
+                before,
+                float(np.linalg.norm(actual_duv - predicted_duv)),
+            )
+            cycle_before.append(before.tolist())
+            cycle_duv.append(actual_duv.tolist())
+            cycle_records.append(
+                {
+                    "phase": phase,
+                    "motion_mm": motion.tolist(),
+                    "before_center_px": before.tolist(),
+                    "after_center_px": after.tolist(),
+                    "predicted_duv_px": predicted_duv.tolist(),
+                    "actual_duv_px": actual_duv.tolist(),
+                    "before_observations": before_records,
+                    "after_observations": after_records,
+                    "probe_diagnostics": diagnostics_out,
+                    "return_diagnostics": diagnostics_return,
+                }
+            )
+
+        event = {
+            "type": "handoff_conditioning_cycle",
+            "cycle": cycle,
+            "path_mm": conditioning_path_mm,
+            "samples": cycle_records,
+            "assessment": None,
+        }
+        converged = False
+        if previous_before is None or previous_duv is None:
+            print(
+                f"[COND CHECK {cycle}] baseline cycle recorded; adjacent cycle required.",
+                flush=True,
+            )
+        else:
+            assessment = _assess_conditioning_cycles(
+                previous_before,
+                previous_duv,
+                cycle_before,
+                cycle_duv,
+                args=args,
+            )
+            converged = cycle >= args.conditioning_min_cycles and assessment["accepted"]
+            event["assessment"] = assessment
+            x_cos = assessment["x_opposition_cosine"]
+            y_cos = assessment["y_opposition_cosine"]
+            print(
+                f"[COND CHECK {cycle - 1}->{cycle}] BEFORE drift="
+                f"{assessment['max_before_drift_px']:.2f}px "
+                f"dUV drift={assessment['max_response_drift_px']:.2f}px "
+                f"oppX={float(x_cos):+.3f} oppY={float(y_cos):+.3f} "
+                f"=> {'PASS' if converged else 'WAIT/FAIL'}",
+                flush=True,
+            )
+
+        session["events"].append(event)
+        _write_json(session_path, session)
+        if converged:
+            print(
+                f"[CONDITIONING PASS] stable after {cycle} cycles; arm is back at anchor.",
+                flush=True,
+            )
+            return last_frame_id, min_capture_timestamp, conditioning_path_mm
+        previous_before = cycle_before
+        previous_duv = cycle_duv
+
+    raise RuntimeError(
+        "handoff XY conditioning did not converge within "
+        f"{args.conditioning_max_cycles} cycles; refusing visual servo/Z"
+    )
+
